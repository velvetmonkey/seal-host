#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Run a doctrine-clean deterministic demo and preserve its evidence."""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("demo", choices=["c1", "c2", "c3", "c4", "c6"])
    parser.add_argument("--output-dir", type=Path)
    parser.add_argument("--color", choices=["auto", "always", "never"], default="auto")
    args = parser.parse_args()

    output = args.output_dir
    if output is None:
        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        output = ROOT / "demo" / "out" / f"{args.demo}-{stamp}-{os.getpid()}"
    output = output.resolve()
    if output.exists() and any(output.iterdir()):
        parser.error(f"output directory is not empty; refusing to overwrite evidence: {output}")
    output.mkdir(parents=True, exist_ok=True)

    demo_name = {"c1": "shell", "c2": "postgres", "c3": "deploy", "c4": "token", "c6": "temporal"}[args.demo]
    command = [
        sys.executable, str(ROOT / "demo" / "golden_path.py"), demo_name,
        "--deterministic", "--artifact-dir", str(output), "--color", args.color,
    ]
    log_path = output / "setup.log"
    with log_path.open("w", encoding="utf-8") as log:
        proc = subprocess.Popen(
            command, cwd=ROOT, text=True,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        )
        assert proc.stdout
        for line in proc.stdout:
            log.write(line)
            log.flush()
            print(line, end="", flush=True)
        code = proc.wait()
    if code != 0:
        print(f"DEMO FAIL exit={code}; partial evidence: {output}", file=sys.stderr)
        return code

    checked = subprocess.run(
        [sys.executable, str(ROOT / "demo" / "doctrine_check.py"), str(output)],
        cwd=ROOT,
    )
    if checked.returncode != 0:
        return checked.returncode
    print(f"ARTIFACT_DIR={output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
